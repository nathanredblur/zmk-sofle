#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&mt {
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        // Custom hold-tap variants that put a macro on the hold side. The stock
        // `&mt` only accepts `&kp` for hold, so we need a custom one if we want
        // HOLD on the right pinky to directly type ñ / é instead of just the
        // Option+N / Option+E dead key.
        //
        // The `zmk,behavior-hold-tap` binding has `#binding-cells = <2>` as a
        // CONST, so both inner bindings must accept exactly one cell. The
        // tap-side `&kp` already takes one cell. For the hold side we make the
        // macro a `behavior-macro-one-param` so it also accepts a cell — we
        // never reference the param inside the macro, so it's effectively a
        // dummy. Usage in the keymap is `&ntilde_ht 0 SEMI` (the 0 is the
        // ignored dummy, SEMI is the tap keycode).
        ntilde_ht: ntilde_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&ntilde>, <&kp>;
        };

        eacute_ht: eacute_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&eacute>, <&kp>;
        };
    };

    macros {
        // Spanish accents — work on macOS with the standard US keyboard layout
        // (where Option+N is the tilde dead-key and Option+E is the acute dead-key).
        // We send the dead key + the vowel in one shot, so a single hold outputs ñ / é.
        // Declared as one-param macros (with the param ignored) so they can sit on
        // the hold side of a hold-tap; see the comment on ntilde_ht above.
        ntilde: ntilde {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <8>;
            tap-ms = <10>;
            bindings = <&kp LA(N)>, <&kp N>;
        };

        eacute: eacute {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <8>;
            tap-ms = <10>;
            bindings = <&kp LA(E)>, <&kp E>;
        };
    };

    combos {
        compatible = "zmk,combos";

        system_combo1 {
            bindings = <&tog 3>;
            key-positions = <0 1>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <4 5>;
            layers = <0>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <7 8>;
            layers = <0>;
        };

        left_bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <3 4>;
            layers = <0>;
        };

        right_bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <8 9>;
            layers = <0>;
        };

        left_parent {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <3 2>;
            layers = <0>;
        };

        right_parent {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <9 10>;
            layers = <0>;
        };

        back_pipe {
            bindings = <&kp BACKSLASH>;
            key-positions = <18 20>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <31 33>;
        };

        caps_word_combo {
            bindings = <&caps_word>;
            key-positions = <26 51>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&mt CAPSLOCK ESCAPE   &kp N1     &kp N2        &kp N3        &kp N4  &kp N5       &kp UP_ARROW     &kp N6         &kp N7     &kp N8     &kp N9            &kp N0             &kp EQUAL
&kp TAB               &kp Q      &kp W         &kp E         &kp R   &kp T        &kp DOWN_ARROW   &kp Y          &kp U      &kp I      &kp O             &kp P              &to 1
&kp LSHFT             &kp A      &kp S         &kp D         &kp F   &kp G        &kp LEFT_ARROW   &kp H          &kp J      &kp K      &kp L             &ntilde_ht 0 SEMI  &eacute_ht 0 APOS
&mt LEFT_SHIFT GRAVE  &kp Z      &kp X         &kp C         &kp V   &kp B        &kp RIGHT_ARROW  &kp N          &kp M      &kp COMMA  &kp DOT           &kp FSLH           &mt RIGHT_SHIFT MINUS
&kp C_MUTE            &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &mo 1   &kp ENTER    &kp ENTER        &kp BACKSPACE  &kp SPACE  &mo 2      &kp LEFT_BRACKET  &kp RIGHT_BRACKET
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "Base";
        };

        Navigation {
            bindings = <
&trans      &kp F1          &kp F2            &kp F3          &kp F4                         &kp F5      &mmv MOVE_UP     &kp F6                  &kp F7              &kp F8               &kp F9                   &kp F10  &kp F11
&trans      &none           &mkp LCLK         &mkp MCLK       &mkp RCLK                      &mkp MB4    &mmv MOVE_DOWN   &kp HOME                &kp PAGE_DOWN       &kp PG_UP            &kp END                  &kp F12  &to 2
&trans      &none           &kp LS(LG(N5))    &kp LS(LG(N3))  &mt LS(LC(LG(N4))) LS(LG(N4))  &mkp MB5    &mmv MOVE_LEFT   &kp LEFT                &kp DOWN_ARROW      &kp UP_ARROW         &kp RIGHT_ARROW          &trans   &trans
&trans      &sk LEFT_SHIFT  &sk LEFT_CONTROL  &sk LEFT_ALT    &sk LEFT_GUI                   &trans      &mmv MOVE_RIGHT  &kp LA(LC(LEFT_ARROW))  &kp LC(LEFT_ARROW)  &kp LC(RIGHT_ARROW)  &kp LA(LC(RIGHT_ARROW))  &trans   &trans
&kp C_MUTE  &trans          &trans            &trans          &trans                         &trans      &mkp LCLK        &trans                  &trans              &trans               &trans                   &trans
            >;

            display-name = "Nav";
            sensor-bindings = <&scroll_encoder>;
        };

        Functions {
            bindings = <
&kp F23  &kp F13  &kp F14   &kp F15     &kp F16     &kp F17       &none  &kp F18    &kp F19          &kp F20          &kp F21          &kp F22  &kp F24
&trans   &none    &kp C_PP  &kp C_PREV  &kp C_NEXT  &kp C_MUTE    &none  &none      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &none    &to 0
&trans   &none    &none     &none       &none       &none         &none  &none      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &none    &none
&trans   &none    &none     &none       &none       &none         &none  &kp KP_N0  &kp KP_N1        &kp KP_NUMBER_2  &kp KP_N3        &none    &none
&none    &trans   &trans    &trans      &trans      &trans        &none  &trans     &trans           &trans           &trans           &trans
            >;

            display-name = "Fn";
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        Configurations {
            bindings = <
&out OUT_TOG     &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_CLR     &none  &none        &none  &none  &none   &none  &none
&none            &none            &none            &none            &none            &bootloader    &none  &bootloader  &none  &none  &none   &none  &none
&rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &sys_reset     &none  &sys_reset   &none  &none  &none   &none  &none
&rgb_ug RGB_SPI  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_SAI  &rgb_ug RGB_SAD  &soft_off      &none  &soft_off    &none  &none  &none   &none  &none
&none            &none            &none            &none            &none            &none          &none  &none        &none  &none  &trans  &none
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN>;
            display-name = "Conf";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
